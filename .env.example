# ============================================================
# MEDIKOOL — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# NE JAMAIS COMMITTER .env
# ============================================================

# Supabase (Backend principal)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase — Variables publiques Vite (accessible côté client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (abonnements B2B, packs de crédits, paiement carte)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Wave Business API (mobile money Sénégal — activé si clé présente)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Orange Money Web Payment API (mobile money — activé si clé présente)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# OpenAI (IA : GPT-4.1-mini, Whisper)
OPENAI_API_KEY=sk-...

# Resend (emails transactionnels + onboarding)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=noreply@medikool.sn

# Nominatim (géocodage OpenStreetMap — pas de clé requise)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Sentry (monitoring erreurs)
SENTRY_DSN=https://...@sentry.io/...
VITE_SENTRY_DSN=https://...@sentry.io/...

# PostHog (analytics cookieless)
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://eu.posthog.com

# Web Push VAPID (notifications push PWA)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# hCaptcha (anti-bot)
HCAPTCHA_SECRET=
VITE_HCAPTCHA_SITEKEY=

# Application
APP_URL=https://medikool.sn
ENCRYPTION_KEY=your-32-byte-encryption-key-for-pgsodium
